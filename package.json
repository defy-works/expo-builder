{
  "name": "expo-builder",
  "version": "0.2.0",
  "description": "Build Expo/React Native apps in ephemeral Tart VMs on a remote Mac — from any OS",
  "license": "MIT",
  "type": "module",
  "bin": {
    "expo-builder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --format=esm --outfile dist/cli.js --banner \"#!/usr/bin/env node\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.1",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.2.3",
    "ignore": "^7.0.5",
    "typescript": "~5.9.0"
  }
}
